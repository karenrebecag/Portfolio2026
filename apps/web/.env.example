# Resend — contact form. Copy to .env.local (local) and Vercel Project → Environment Variables (prod).
# API keys: https://resend.com/api-keys

RESEND_API_KEY=

# Where submissions are delivered (your inbox).
CONTACT_TO_EMAIL=karenrortizg@gmail.com

# Sender shown in the inbox. Two modes:
#
# SANDBOX (quick test, no domain):
#   CONTACT_FROM_EMAIL=Karen Ortiz Portfolio <onboarding@resend.dev>
#   Resend ONLY delivers to the email on your Resend account (see Resend → Settings).
#   Set CONTACT_TO_EMAIL to that same address or sends will fail with 503.
#
# PRODUCTION (verified domain on resend.com/domains — karenrebecaortiz.com):
#   CONTACT_FROM_EMAIL=Karen Ortiz <hola@karenrebecaortiz.com>
#   CONTACT_TO_EMAIL=where you read briefs (Gmail is fine): karenrortizg@gmail.com
# Receiving (inbound MX) in Resend is NOT required for the contact form.
CONTACT_FROM_EMAIL=Karen Ortiz <hola@karenrebecaortiz.com>
{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"],
      "env": ["PAYLOAD_API_URL", "REVALIDATE_SECRET", "NEXT_PUBLIC_SITE_URL"]
    }
  }
}
